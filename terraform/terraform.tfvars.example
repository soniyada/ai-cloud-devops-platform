# Copy to terraform.tfvars and fill in real values (terraform.tfvars is git-ignored)
aws_region    = "ap-south-1"
project_name  = "ai-cloud-devops"
instance_type = "t3.micro"
my_ip         = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
repo_url      = "https://github.com/YOUR_USERNAME/ai-cloud-devops-platform.git"
